{
  "$comment": "KRYLO production and destructive-action policy. Consumed by scripts/security/risk-gate.mjs. Patterns are matched against Bash and PowerShell tool commands after whitespace normalization; matching is case-insensitive substring/regex per entry. Markdown intent: SECURITY.md, plugin references/risk-policy.md.",
  "approvalClasses": {
    "production-deploy": {
      "decision": "deny",
      "reason": "Production deployment requires explicit user approval (RISK_APPROVAL_REQUIRED).",
      "patterns": [
        "\\bvercel\\b.*\\b(--prod|deploy)\\b",
        "\\bnetlify\\s+deploy\\b.*--prod",
        "\\bfly\\s+deploy\\b",
        "\\bfirebase\\s+deploy\\b",
        "\\bcdk\\s+deploy\\b",
        "\\bserverless\\s+deploy\\b",
        "\\bkubectl\\b[^|;&\\n]*?\\b(apply|create|delete|patch|replace|scale|rollout)\\b",
        "\\bhelm\\b[^|;&\\n]*?\\b(install|upgrade|uninstall|rollback)\\b",
        "\\bterraform\\b[^|;&\\n]*?\\b(apply|destroy)\\b",
        "\\bpulumi\\b[^|;&\\n]*?\\b(up|destroy)\\b",
        "\\bgcloud\\b[^|;&\\n]*?\\bdeploy\\b",
        "\\baws\\b[^|;&\\n]*?\\b(create-stack|update-stack|delete-stack|deploy)\\b",
        "\\baz\\b[^|;&\\n]*?\\b(deployment|webapp|functionapp)\\b[^|;&\\n]*?\\b(create|delete|deploy)\\b"
      ]
    },
    "production-data-write": {
      "decision": "deny",
      "reason": "Production data writes and migrations require explicit user approval.",
      "patterns": [
        "\\bsupabase\\b[^|;&\\n]*?\\bdb\\b[^|;&\\n]*?\\bpush\\b[^|;&\\n]*?--linked",
        "\\bprisma\\b[^|;&\\n]*?\\bmigrate\\b[^|;&\\n]*?\\bdeploy\\b",
        "\\bmigrate\\b[^|;&\\n]*?\\b(production|prod)\\b"
      ]
    },
    "destructive-operation": {
      "decision": "deny",
      "reason": "Destructive operations require explicit user approval.",
      "patterns": [
        "\\bdrop\\s+(table|database|schema)\\b",
        "\\btruncate\\s+table\\b",
        "\\bsupabase\\b[^|;&\\n]*?\\bdb\\b[^|;&\\n]*?\\breset\\b",
        "\\bprisma\\b[^|;&\\n]*?\\bmigrate\\b[^|;&\\n]*?\\breset\\b",
        "\\brails\\s+db:drop\\b",
        "\\bgit\\b[^|;&\\n]*?\\breset\\s+--hard\\b",
        "\\bgit\\b[^|;&\\n]*?\\bclean\\s+-[a-z]*f",
        "\\bgit\\b[^|;&\\n]*?\\bcheckout\\s+--\\s+\\.",
        "\\bgit\\b[^|;&\\n]*?\\brestore\\s+(--worktree\\s+)?\\.(?:\\s|$)",
        "\\brm\\s+(-[a-z]*[rf][a-z]*\\s+)+(/|~|\\$HOME|[a-z]:\\\\)",
        "\\bremove-item\\b[^|;&\\n]*?-(recurse|force)\\b",
        "\\bgit\\b[^|;&\\n]*?\\bbranch\\s+-[dD]\\b",
        "\\bgit\\b[^|;&\\n]*?\\bstash\\s+(drop|clear)\\b"
      ]
    },
    "package-publish": {
      "decision": "deny",
      "reason": "Package publication requires explicit user approval.",
      "patterns": [
        "\\bnpm\\s+publish\\b",
        "\\bpnpm\\s+publish\\b",
        "\\byarn\\s+(npm\\s+)?publish\\b",
        "\\btwine\\s+upload\\b",
        "\\bpython?\\s+-m\\s+twine\\b",
        "\\bcargo\\s+publish\\b",
        "\\bgem\\s+push\\b",
        "\\bdocker\\b[^|;&\\n]*?\\bpush\\b",
        "\\bnuget\\b[^|;&\\n]*?\\bpush\\b"
      ]
    },
    "release": {
      "decision": "deny",
      "reason": "Release creation requires explicit user approval.",
      "patterns": [
        "\\bgh\\b[^|;&\\n]*?\\brelease\\b[^|;&\\n]*?\\b(create|edit|delete|upload)\\b",
        "\\bgit\\b[^|;&\\n]*?\\bpush\\b[^|;&\\n]*--tags",
        "\\bgoreleaser\\b"
      ]
    },
    "git-push": {
      "decision": "deny",
      "reason": "Git push requires explicit user approval unless the active task explicitly requested the exact action.",
      "patterns": [
        "\\bgit\\b[^|;&\\n]*?\\bpush\\b"
      ]
    },
    "git-force": {
      "decision": "deny",
      "reason": "Force push is never automatic.",
      "patterns": [
        "\\bgit\\b[^|;&\\n]*?\\bpush\\b[^|;&\\n]*(--force(-with-lease)?\\b|\\s-f\\b|\\s\\+\\S+)"
      ]
    },
    "merge": {
      "decision": "deny",
      "reason": "Merging pull requests requires explicit user approval.",
      "patterns": [
        "\\bgh\\b[^|;&\\n]*?\\bpr\\b[^|;&\\n]*?\\bmerge\\b"
      ]
    },
    "iam-or-secrets": {
      "decision": "deny",
      "reason": "IAM, RBAC, firewall, DNS, and secret changes require explicit user approval.",
      "patterns": [
        "\\baws\\b[^|;&\\n]*?\\biam\\b[^|;&\\n]*?\\b(create|delete|put|attach|detach|update)\\b",
        "\\bgcloud\\b[^|;&\\n]*?\\biam\\b[^|;&\\n]*?\\b(add|remove|create|delete|set)\\b",
        "\\bkubectl\\b[^|;&\\n]*?\\bsecret\\b[^|;&\\n]*?\\b(create|delete|patch)\\b",
        "\\bgh\\b[^|;&\\n]*?\\bsecret\\b[^|;&\\n]*?\\b(set|delete)\\b",
        "\\bvault\\b[^|;&\\n]*?\\b(write|delete|kv\\s+put)\\b",
        "\\bdoctl\\b[^|;&\\n]*?\\bfirewall\\b",
        "\\bcloudflare\\b[^|;&\\n]*?\\bdns\\b"
      ]
    },
    "payment": {
      "decision": "deny",
      "reason": "Payment, refund, payout, and billing actions require explicit user approval.",
      "patterns": [
        "\\bstripe\\b[^|;&\\n]*?\\b(charges|refunds|payouts|invoices)\\b[^|;&\\n]*?\\b(create|update|capture|pay)\\b"
      ]
    },
    "external-message": {
      "decision": "deny",
      "reason": "External messages to broad audiences require explicit user approval.",
      "patterns": [
        "\\b(sendgrid|mailgun|twilio|slack)\\b[^|;&\\n]*?\\b(send|post|broadcast)\\b"
      ]
    },
    "external-write": {
      "decision": "deny",
      "reason": "Installing, starting, or configuring an optional external adapter, and writing source or documentation through one, require explicit user approval (adapters/omniroute.md, adapters/code-review-graph.md).",
      "patterns": [
        "\\b(npm|npx|pnpm|yarn|bunx)\\b[^|;&\\n]{0,200}\\bomniroute\\b",
        "\\bomniroute\\b[^|;&\\n]{0,80}\\b(start|serve|up|reset-password)\\b",
        "\\bomniroute-reset-password\\b",
        "\\bdocker\\b[^|;&\\n]{0,200}\\bomniroute\\b",
        "\\b(yay|paru|pacman)\\b[^|;&\\n]{0,120}\\bomniroute\\b",
        "\\b(uvx|pipx?|uv\\s+tool\\s+install)\\b[^|;&\\n]{0,200}\\bcode[-_]review[-_]graph\\b",
        "\\bcode[-_]review[-_]graph\\b[^|;&\\n]{0,80}\\b(apply|serve|daemon)\\b"
      ]
    }
  },
  "sensitivePaths": {
    "decision": "deny",
    "reason": "Secret files are off-limits to KRYLO.",
    "patterns": [
      "(^|[\\\\/])\\.env($|\\.|[\\\\/])",
      "(^|[\\\\/])\\.npmrc$",
      "(^|[\\\\/])\\.pypirc$",
      "(^|[\\\\/])\\.netrc$",
      "(^|[\\\\/])\\.ssh[\\\\/]",
      "(^|[\\\\/])\\.aws[\\\\/]credentials",
      "(^|[\\\\/])\\.config[\\\\/]gh[\\\\/]hosts\\.yml",
      "(^|[\\\\/])\\.kube[\\\\/]config",
      "(^|[\\\\/])id_(rsa|ed25519|ecdsa|dsa)($|\\.)",
      "\\.(pem|pfx|p12|key|keystore|jks)$",
      "(^|[\\\\/])secrets?\\.(json|ya?ml|toml)$",
      "(^|[\\\\/])\\.openwiki[\\\\/]\\.env"
    ]
  },
  "failMode": "fail-safe",
  "inactiveRunBehavior": "allow",
  "$inactiveRunNote": "KRYLO gates enforce policy only while a KRYLO run is active in the current project. Ordinary Claude Code sessions are not intercepted (ADR-0009); Claude Code's own permission system remains in charge."
}
