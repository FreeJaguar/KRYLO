{
  "$comment": "KRYLO production and destructive-action policy. Consumed by scripts/security/risk-gate.mjs. Patterns are matched against Bash tool commands after whitespace normalization; matching is case-insensitive substring/regex per entry. Markdown intent: SECURITY.md, plugin references/risk-policy.md.",
  "approvalClasses": {
    "production-deploy": {
      "decision": "deny",
      "reason": "Production deployment requires explicit user approval (RISK_APPROVAL_REQUIRED).",
      "patterns": [
        "\\bvercel\\b.*\\b(--prod|deploy)\\b",
        "\\bnetlify\\s+deploy\\b.*--prod",
        "\\bfly\\s+deploy\\b",
        "\\bfirebase\\s+deploy\\b",
        "\\bcdk\\s+deploy\\b",
        "\\bserverless\\s+deploy\\b",
        "\\bkubectl\\s+(apply|create|delete|patch|replace|scale|rollout)\\b",
        "\\bhelm\\s+(install|upgrade|uninstall|rollback)\\b",
        "\\bterraform\\s+(apply|destroy)\\b",
        "\\bpulumi\\s+(up|destroy)\\b",
        "\\bgcloud\\s+.*\\bdeploy\\b",
        "\\baws\\s+.*\\b(create-stack|update-stack|delete-stack|deploy)\\b",
        "\\baz\\s+(deployment|webapp|functionapp)\\b.*\\b(create|delete|deploy)\\b"
      ]
    },
    "production-data-write": {
      "decision": "deny",
      "reason": "Production data writes and migrations require explicit user approval.",
      "patterns": [
        "\\bsupabase\\s+db\\s+push\\b.*--linked",
        "\\bprisma\\s+migrate\\s+deploy\\b",
        "\\bmigrate\\b.*\\b(production|prod)\\b"
      ]
    },
    "destructive-operation": {
      "decision": "deny",
      "reason": "Destructive operations require explicit user approval.",
      "patterns": [
        "\\bdrop\\s+(table|database|schema)\\b",
        "\\btruncate\\s+table\\b",
        "\\bsupabase\\s+db\\s+reset\\b",
        "\\bprisma\\s+migrate\\s+reset\\b",
        "\\brails\\s+db:drop\\b",
        "\\bgit\\s+reset\\s+--hard\\b",
        "\\bgit\\s+clean\\s+-[a-z]*f",
        "\\bgit\\s+checkout\\s+--\\s+\\.",
        "\\bgit\\s+restore\\s+(--worktree\\s+)?\\.(?:\\s|$)",
        "\\brm\\s+(-[a-z]*[rf][a-z]*\\s+)+(/|~|\\$HOME|[a-z]:\\\\)",
        "\\bgit\\s+branch\\s+-[dD]\\b",
        "\\bgit\\s+stash\\s+(drop|clear)\\b"
      ]
    },
    "package-publish": {
      "decision": "deny",
      "reason": "Package publication requires explicit user approval.",
      "patterns": [
        "\\bnpm\\s+publish\\b",
        "\\bpnpm\\s+publish\\b",
        "\\byarn\\s+(npm\\s+)?publish\\b",
        "\\btwine\\s+upload\\b",
        "\\bpython?\\s+-m\\s+twine\\b",
        "\\bcargo\\s+publish\\b",
        "\\bgem\\s+push\\b",
        "\\bdocker\\s+push\\b",
        "\\bnuget\\s+push\\b"
      ]
    },
    "release": {
      "decision": "deny",
      "reason": "Release creation requires explicit user approval.",
      "patterns": [
        "\\bgh\\s+release\\s+(create|edit|delete|upload)\\b",
        "\\bgit\\s+push\\b.*--tags",
        "\\bgoreleaser\\b"
      ]
    },
    "git-push": {
      "decision": "deny",
      "reason": "Git push requires explicit user approval unless the active task explicitly requested the exact action.",
      "patterns": [
        "\\bgit\\s+push\\b"
      ]
    },
    "git-force": {
      "decision": "deny",
      "reason": "Force push is never automatic.",
      "patterns": [
        "\\bgit\\s+push\\b.*(--force|-f\\b|--force-with-lease)"
      ]
    },
    "merge": {
      "decision": "deny",
      "reason": "Merging pull requests requires explicit user approval.",
      "patterns": [
        "\\bgh\\s+pr\\s+merge\\b"
      ]
    },
    "iam-or-secrets": {
      "decision": "deny",
      "reason": "IAM, RBAC, firewall, DNS, and secret changes require explicit user approval.",
      "patterns": [
        "\\baws\\s+iam\\b.*\\b(create|delete|put|attach|detach|update)\\b",
        "\\bgcloud\\s+iam\\b.*\\b(add|remove|create|delete|set)\\b",
        "\\bkubectl\\s+.*\\bsecret\\b.*\\b(create|delete|patch)\\b",
        "\\bgh\\s+secret\\s+(set|delete)\\b",
        "\\bvault\\s+(write|delete|kv\\s+put)\\b",
        "\\bdoctl\\b.*\\bfirewall\\b",
        "\\bcloudflare\\b.*\\bdns\\b"
      ]
    },
    "payment": {
      "decision": "deny",
      "reason": "Payment, refund, payout, and billing actions require explicit user approval.",
      "patterns": [
        "\\bstripe\\s+(charges|refunds|payouts|invoices)\\b.*\\b(create|update|capture|pay)\\b"
      ]
    },
    "external-message": {
      "decision": "deny",
      "reason": "External messages to broad audiences require explicit user approval.",
      "patterns": [
        "\\b(sendgrid|mailgun|twilio|slack)\\b.*\\b(send|post|broadcast)\\b"
      ]
    }
  },
  "sensitivePaths": {
    "decision": "deny",
    "reason": "Secret files are off-limits to KRYLO.",
    "patterns": [
      "(^|[\\\\/])\\.env($|\\.|[\\\\/])",
      "(^|[\\\\/])\\.npmrc$",
      "(^|[\\\\/])\\.pypirc$",
      "(^|[\\\\/])\\.netrc$",
      "(^|[\\\\/])\\.ssh[\\\\/]",
      "(^|[\\\\/])\\.aws[\\\\/]credentials",
      "(^|[\\\\/])\\.config[\\\\/]gh[\\\\/]hosts\\.yml",
      "(^|[\\\\/])\\.kube[\\\\/]config",
      "(^|[\\\\/])id_(rsa|ed25519|ecdsa|dsa)($|\\.)",
      "\\.(pem|pfx|p12|key|keystore|jks)$",
      "(^|[\\\\/])secrets?\\.(json|ya?ml|toml)$",
      "(^|[\\\\/])\\.openwiki[\\\\/]\\.env"
    ]
  },
  "failMode": "fail-safe",
  "inactiveRunBehavior": "allow",
  "$inactiveRunNote": "KRYLO gates enforce policy only while a KRYLO run is active in the current project. Ordinary Claude Code sessions are not intercepted (ADR-0009); Claude Code's own permission system remains in charge."
}
