{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krylo.dev/schemas/run-state.schema.json",
  "title": "KRYLO Run State",
  "description": "Persisted state of one KRYLO run. Contains only normalized metadata: no raw prompts, tool arguments, shell commands, source code, stack traces, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kryloVersion",
    "host",
    "delegation",
    "runId",
    "project",
    "goal",
    "acceptanceCriteria",
    "agents",
    "toolCounters",
    "orbit",
    "questionGate",
    "riskApprovals",
    "findings",
    "evidence",
    "phase",
    "terminalState",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Semantic version of this schema.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kryloVersion": {
      "type": "string",
      "description": "KRYLO plugin version that created the run."
    },
    "host": {
      "type": "object",
      "description": "The host this run executes on and its host-specific session identity. A host describes where the run executes; delegation (below) describes how it was reached.",
      "additionalProperties": false,
      "required": ["name", "sessionId"],
      "properties": {
        "name": { "type": "string", "enum": ["claude", "codex"] },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "turnId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "delegation": {
      "type": "object",
      "description": "How this run was reached: directly, or as a bounded delegation from another run/worker.",
      "additionalProperties": false,
      "required": ["externalWorker", "depth"],
      "properties": {
        "externalWorker": { "type": "boolean" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 1 },
        "parentRunId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" }
      }
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{4,64}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootHash"],
      "properties": {
        "rootHash": {
          "type": "string",
          "description": "SHA-256 hash of the normalized project root path. The raw path is not persisted.",
          "pattern": "^[a-f0-9]{64}$"
        },
        "branch": { "type": "string" },
        "headShaShort": { "type": "string", "maxLength": 16 },
        "dirtyAtStart": { "type": "boolean" }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized", "lane", "risk"],
      "properties": {
        "normalized": {
          "type": "string",
          "description": "Short, redacted, normalized goal summary. Not the raw prompt.",
          "maxLength": 300
        },
        "lane": {
          "type": "string",
          "enum": ["PATCH", "BUILD", "DESIGN", "PRODUCT", "INCIDENT", "MIGRATION", "AUDIT", "AI", "PERFORMANCE"]
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "complexity": {
          "type": "string",
          "enum": ["trivial", "normal", "complex"]
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d{1,3}$" },
          "description": { "type": "string", "maxLength": 300 },
          "status": {
            "type": "string",
            "enum": ["pending", "proven", "failed", "blocked", "not-applicable"]
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 }
    },
    "nonGoals": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "configuredModel", "status"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "description": "Agent name, for example krylo:builder." },
          "configuredModel": { "type": "string" },
          "resolvedModel": {
            "type": ["string", "null"],
            "description": "Resolved model reported by the platform, or null when unavailable. Never inferred."
          },
          "status": {
            "type": "string",
            "enum": ["running", "completed", "failed", "stopped", "cancelled"]
          },
          "startedAt": { "type": "string", "format": "date-time" },
          "endedAt": { "type": ["string", "null"], "format": "date-time" },
          "taskLabel": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "toolCounters": {
      "type": "object",
      "description": "Tool name to invocation count. Names only, never arguments.",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "orbit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "cycle", "stopBlocks", "fingerprints", "stagnation"],
      "properties": {
        "budget": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cycle": { "type": "integer", "minimum": 0 },
        "stopBlocks": {
          "type": "integer",
          "minimum": 0,
          "description": "How many times the Stop gate has forced continuation. Guards against infinite loops."
        },
        "fingerprints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hash", "category", "count", "firstSeenCycle", "lastSeenCycle"],
            "properties": {
              "hash": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
              "category": {
                "type": "string",
                "enum": ["test", "build", "lint", "types", "runtime", "tool", "environment", "other"]
              },
              "count": { "type": "integer", "minimum": 1 },
              "firstSeenCycle": { "type": "integer", "minimum": 0 },
              "lastSeenCycle": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "stagnation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cyclesWithoutProgress", "lastProgressCycle"],
          "properties": {
            "cyclesWithoutProgress": { "type": "integer", "minimum": 0 },
            "lastProgressCycle": { "type": "integer", "minimum": 0 }
          }
        },
        "strategyChanges": { "type": "integer", "minimum": 0 },
        "lastStrategy": { "type": "string", "maxLength": 200 },
        "requiredStrategyChange": { "type": "boolean" }
      }
    },
    "questionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "used", "grants"],
      "properties": {
        "budget": { "type": "integer", "minimum": 0, "maximum": 3 },
        "used": { "type": "integer", "minimum": 0 },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "status", "grantedAt"],
            "properties": {
              "id": { "type": "string" },
              "category": {
                "type": "string",
                "enum": [
                  "missing-credential",
                  "destructive-production-action",
                  "material-business-decision",
                  "legal-or-compliance",
                  "privacy",
                  "financial",
                  "high-impact-security",
                  "no-safe-default"
                ]
              },
              "status": { "type": "string", "enum": ["available", "consumed", "expired"] },
              "grantedAt": { "type": "string", "format": "date-time" },
              "consumedAt": { "type": ["string", "null"], "format": "date-time" }
            }
          }
        }
      }
    },
    "riskApprovals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actionClass", "status", "requestedAt"],
        "properties": {
          "id": { "type": "string" },
          "actionClass": {
            "type": "string",
            "enum": [
              "production-deploy",
              "production-data-write",
              "destructive-operation",
              "package-publish",
              "release",
              "git-push",
              "git-force",
              "merge",
              "iam-or-secrets",
              "payment",
              "external-message",
              "external-write",
              "repository-admin",
              "other"
            ]
          },
          "status": { "type": "string", "enum": ["pending", "approved", "denied", "consumed", "expired"] },
          "requestedAt": { "type": "string", "format": "date-time" },
          "resolvedAt": { "type": ["string", "null"], "format": "date-time" },
          "summary": { "type": "string", "maxLength": 200 },
          "projectRootHash": {
            "type": "string",
            "description": "SHA-256 hash of the project root this approval was requested in. Consumption is refused if the current run's project does not match.",
            "pattern": "^[a-f0-9]{64}$"
          },
          "runId": {
            "type": "string",
            "description": "The run this approval was requested by. Consumption is refused for any other run."
          },
          "environment": {
            "type": ["string", "null"],
            "description": "Optional security profile bound at request time. Consumption is refused if the current profile differs."
          },
          "expiresAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "An approved-but-expired approval is treated as not-approved and can never be consumed."
          },
          "consumedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Set the moment this single-use approval is spent by a matching action."
          },
          "fingerprint": {
            "type": ["string", "null"],
            "description": "SHA-256 hash of the normalized, redacted action that consumed this approval. Recorded for audit only; never used to authorize a second action."
          },
          "target": {
            "type": ["string", "null"],
            "maxLength": 300,
            "description": "Redacted, truncated description of the action that consumed this approval. Never the raw command or a secret."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "summary"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "status": { "type": "string", "enum": ["open", "resolved", "accepted", "invalid"] },
          "summary": { "type": "string", "maxLength": 300 },
          "source": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "./evidence.schema.json" }
    },
    "phase": {
      "type": "string",
      "enum": [
        "INITIALIZING",
        "CLASSIFYING",
        "PLANNING",
        "EXECUTING",
        "VERIFYING",
        "REVIEWING",
        "CORRECTING",
        "COMPLETING",
        "BLOCKED",
        "AWAITING_DECISION",
        "AWAITING_RISK_APPROVAL",
        "ITERATION_LIMIT"
      ]
    },
    "terminalState": {
      "type": ["string", "null"],
      "enum": [
        "VERIFIED_COMPLETE",
        "SAFE_BLOCKED",
        "USER_DECISION_REQUIRED",
        "RISK_APPROVAL_REQUIRED",
        "ITERATION_LIMIT_REACHED",
        "CANCELLED_BY_USER",
        null
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
